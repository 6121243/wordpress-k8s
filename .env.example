# Copier ce fichier en .env puis remplacer les valeurs :
#   cp .env.example .env && nano .env
# Le fichier .env est ignoré par Git (.gitignore) : il ne doit JAMAIS être commité.
# Générer un mot de passe robuste : openssl rand -base64 24
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=A_REMPLACER
MYSQL_ROOT_PASSWORD=A_REMPLACER
